ENV=development
PORT=8000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
GRID_API_URL=
TELEMETRY_TIMEOUT_SECONDS=5
TELEMETRY_POLL_SECONDS=60
TELEMETRY_STALE_AFTER_SECONDS=300
REPLAN_DRIFT_THRESHOLD=0.15
SOLVER_TOLERANCE=0.000001
VOLTAGE_MIN_PU=0.95
VOLTAGE_MAX_PU=1.05
MAX_LINE_LOADING_PERCENT=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173